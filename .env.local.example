# spec §4 — 전부 서버 전용. NEXT_PUBLIC_ 접두사 변수를 만들지 않는다.
# 이 파일을 .env.local 로 복사한 뒤 값을 채운다. .env.local 은 커밋되지 않는다.

# AI 호출 (§4.3) — **주 공급자는 DeepSeek이다.**
# platform.deepseek.com/api_keys 에서 발급(sk- 접두사). 종량제라 잔액이 필요하다.
# 키를 넣은 뒤 반드시: npm run probe:deepseek
#
# ⚠ DeepSeek은 json_schema strict 모드가 없다(json_object 까지만 지원).
#    출력 구조는 lib/ai/schema.ts 의 로컬 검증이 강제한다 — 근거는 lib/ai/deepseek.ts 주석.
DEEPSEEK_API_KEY=

# 선택 — 모델 덮어쓰기. 공급자 안에서 모델만 바꾼다. 비우면 각 공급자의 기본값.
#   deepseek 기본 deepseek-v4-flash  ← 이 프로젝트가 쓰는 유일한 모델
#   gemini   기본 gemini-3.5-flash   (flash 계열만 무료. pro는 429)
#
# ⚠ pro 계열은 넣지 않는다. deepseek 경로는 pro·비flash 값을 받으면 즉시 던진다.
AI_MODEL=

# 예비 공급자 (§4.3) — 주 경로가 과부하·잔액으로 막혔을 때 갈아탄다.
# aistudio.google.com/apikey 의 무료 티어 키. 결제 계정이 연결된 프로젝트 키는 429가 난다.
# 무료 티어는 모델당 하루 20회라 §20 대본 3회분이다 — 상시 경로로 쓰지 않는다.
# 비우면 deepseek. gemini 를 넣으면 예비 경로로 전환.
AI_PROVIDER=
GEMINI_API_KEY=

# DB · Storage (§5, §16.3) — service role 키는 서버 라우트에서만 사용
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 이메일 (§13.3)
RESEND_API_KEY=

# 기획자 인증 (§14.2)
ADMIN_PASSWORD=
SESSION_SECRET=

# 이메일 본문의 절대 URL 생성용 (§13.3). 로컬은 http://localhost:3000
SITE_URL=http://localhost:3000

# 이메일 본문 문의처 안내 (§13.3). 폼 입력 항목이 아니다
CONTACT_INFO=
