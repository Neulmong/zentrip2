# spec §4 — 전부 서버 전용. NEXT_PUBLIC_ 접두사 변수를 만들지 않는다.
# 이 파일을 .env.local 로 복사한 뒤 값을 채운다. .env.local 은 커밋되지 않는다.

# AI 호출 (§4.3) — AI Studio 무료 티어 키. aistudio.google.com/apikey
# 결제 계정이 연결된 프로젝트의 키는 429가 난다. 무료 등급 프로젝트에서 발급할 것.
GEMINI_API_KEY=

# 선택 — 모델 덮어쓰기. 무료 티어 한도·과부하(503) 시 교체용.
# 기본값 gemini-3.5-flash. flash 계열만 무료다(pro는 429).
AI_MODEL=

# 예비 공급자 (§4.3) — Gemini가 429·503으로 막혔을 때 갈아탄다.
# console.upstage.ai/api-keys 에서 발급. AI_PROVIDER=solar 로 전환.
AI_PROVIDER=
UPSTAGE_API_KEY=

# DB · Storage (§5, §16.3) — service role 키는 서버 라우트에서만 사용
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 이메일 (§13.3)
RESEND_API_KEY=

# 기획자 인증 (§14.2)
ADMIN_PASSWORD=
SESSION_SECRET=

# 이메일 본문의 절대 URL 생성용 (§13.3). 로컬은 http://localhost:3000
SITE_URL=http://localhost:3000

# 이메일 본문 문의처 안내 (§13.3). 폼 입력 항목이 아니다
CONTACT_INFO=
