# spec §4 — 전부 서버 전용. NEXT_PUBLIC_ 접두사 변수를 만들지 않는다.
# 이 파일을 .env.local 로 복사한 뒤 값을 채운다. .env.local 은 커밋되지 않는다.

# AI 호출 (§4.3) — **공급자는 Gemini다.**
# aistudio.google.com/apikey 에서 발급. 기본 모델은 gemini-3.5-flash-lite.
# 키를 넣은 뒤 확인: npm run probe:gemini
#
# ⚠ 무료 티어는 모델당 하루 20회라 §20 대본 3회분밖에 못 버틴다.
#    상시 사용은 결제 계정(종량제) 키를 전제로 한다.
GEMINI_API_KEY=

# 선택 — 모델 덮어쓰기. 비우면 기본값 gemini-3.5-flash-lite.
# 다른 flash 계열(예: gemini-2.5-flash)로 갈아탈 때만 채운다.
AI_MODEL=

# DB · Storage (§5, §16.3) — service role 키는 서버 라우트에서만 사용
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 이메일 (§13.3)
RESEND_API_KEY=

# 기획자 인증 (§14.2)
ADMIN_PASSWORD=
SESSION_SECRET=

# 이메일 본문의 절대 URL 생성용 (§13.3). 로컬은 http://localhost:3000
SITE_URL=http://localhost:3000

# 이메일 본문 문의처 안내 (§13.3). 폼 입력 항목이 아니다
CONTACT_INFO=

# ── 테스트 전용 (앱 실행에는 필요 없다) ─────────────────────────
#
# npm run test:security 의 U-01~U-05(익명 접근 차단)에만 쓰인다.
# 대시보드 > Project Settings > API Keys의 **anon/public** 값이다 — service_role이 아니다.
# 비워 두면 그 항목만 건너뛰고 나머지는 정상 실행된다.
SUPABASE_ANON_KEY=

# npm run test:demo 의 신청 폼이 쓸 수신 주소.
# Resend 도메인 미인증 상태이므로 **가입 이메일 주소로만** 실제 발송된다(§13.3).
# 비워 두면 delivered@resend.dev(테스트 주소)로 간다.
TEST_EMAIL_TO=
